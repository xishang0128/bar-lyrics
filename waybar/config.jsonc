{
  "modules-center": ["custom/bar-lyrics", "image#bar-lyrics-cover"],

  "custom/bar-lyrics": {
    "exec": "exec $HOME/.local/bin/bar-lyrics < $HOME/.config/bar-lyrics/waybar.json",
    "return-type": "json",
    "restart-interval": 2,
    "hide-empty-text": true,
    "escape": false
  },

  "image#bar-lyrics-cover": {
    "path": "/run/user/1000/bar-lyrics-cover",
    "size": 24,
    "interval": "once",
    "signal": 8,
    "tooltip": false
  }
}
